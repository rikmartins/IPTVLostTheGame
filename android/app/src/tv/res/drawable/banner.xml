<?xml version="1.0" encoding="utf-8"?>
<!-- Banner provisório do launcher Android TV (320x180 dp): o ícone da app
     sobre o fundo do tema. Para um banner com o nome/logótipo, trocar por
     uma imagem banner.png de 320x180 px em drawable-xhdpi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp"/>
            <solid android:color="#0E0F13"/>
        </shape>
    </item>
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp"/>
</layer-list>
